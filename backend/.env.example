# Copy to backend/.env and adjust. Never commit the real .env file.

APP_NAME="HRMS API"
# development | test | production  (seed_demo refuses to run in production)
ENVIRONMENT=development

# SQLAlchemy URL — psycopg 3 driver
DATABASE_URL=postgresql+psycopg://hrms:change_me@localhost:5432/hrms
# Used only by the pytest suite (a separate, disposable database)
TEST_DATABASE_URL=postgresql+psycopg://hrms:change_me@localhost:5432/hrms_test

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings — set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Initial administrator created by:  python -m app.scripts.bootstrap_admin
BOOTSTRAP_ADMIN_USER_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Password used for every demo account created by:  python -m app.scripts.seed_demo
DEMO_USER_PASSWORD=
